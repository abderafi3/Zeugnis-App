<Project>

  <!-- Inherit the repo-wide settings first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <_IsProductionCode>false</_IsProductionCode>

    <!-- Test method names use snake_case_with_underscores by convention. -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA2007</NoWarn>
  </PropertyGroup>

</Project>
