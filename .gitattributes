# Normalize line endings
* text=auto

*.cs text diff=csharp eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.xaml text eol=lf

# Binary assets — never diff or convert
*.docx binary
*.xlsx binary
*.png binary
*.ico binary
*.pfx binary
