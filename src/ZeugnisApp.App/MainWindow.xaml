<ui:FluentWindow x:Class="ZeugnisApp.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:ZeugnisApp.App.Views"
                 xmlns:res="clr-namespace:ZeugnisApp.App.Resources"
                 Title="{x:Static res:Strings.App_Title}"
                 Icon="pack://application:,,,/ZeugnisApp;component/Resources/app.ico"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Width="1200"
                 Height="800"
                 MinWidth="900"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static res:Strings.App_Title}"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           PaneDisplayMode="Left"
                           OpenPaneLength="240">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Start}"
                                       TargetPageType="{x:Type views:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Klassen}"
                                       TargetPageType="{x:Type views:KlassenPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="People24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Zeugnisse}"
                                       TargetPageType="{x:Type views:ZeugnissePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentText24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Formulare}"
                                       TargetPageType="{x:Type views:FormularePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentBulletList24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Floskeln}"
                                       TargetPageType="{x:Type views:FloskelnPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="TextBulletListSquare24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Fehlzeiten}"
                                       TargetPageType="{x:Type views:FehlzeitenPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="CalendarClock24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Papierkorb}"
                                       TargetPageType="{x:Type views:PapierkorbPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Einstellungen}"
                                       TargetPageType="{x:Type views:EinstellungenPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <Border Grid.Row="2"
                Padding="16,6"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding SaveStatus.StatusText}" />
        </Border>
    </Grid>
</ui:FluentWindow>
