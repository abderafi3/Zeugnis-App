<Page x:Class="ZeugnisApp.App.Views.FehlzeitenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:ZeugnisApp.App.Resources"
      ScrollViewer.CanContentScroll="False"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{x:Static res:Strings.Nav_Fehlzeiten}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{x:Static res:Strings.Fehlzeiten_Title}" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static res:Strings.Fehlzeiten_Intro}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Static res:Strings.Fehlzeiten_Klasse}" />
            <ComboBox Margin="8,0,0,0" MinWidth="180"
                      ItemsSource="{Binding Klassen}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedKlasse}" />
            <TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding TermText}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static res:Strings.Fehlzeiten_NoKlasse}"
                   Visibility="{Binding HasKlasse, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

        <TextBlock Grid.Row="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static res:Strings.Fehlzeiten_Empty}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IstGueltig}" Value="False">
                            <Setter Property="Background" Value="#22D13438" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" IsReadOnly="True"
                                    Header="{x:Static res:Strings.Fehlzeiten_Col_Name}"
                                    Binding="{Binding AnzeigeName}" />
                <DataGridTemplateColumn Width="160" Header="{x:Static res:Strings.Fehlzeiten_Col_Gesamt}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:NumberBox Margin="4,3" Minimum="0" SmallChange="1"
                                          ClearButtonEnabled="False"
                                          Value="{Binding Gesamt, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue=0}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="180" Header="{x:Static res:Strings.Fehlzeiten_Col_Unentschuldigt}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:NumberBox Margin="4,3" Minimum="0" SmallChange="1"
                                          ClearButtonEnabled="False"
                                          Value="{Binding Unentschuldigt, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue=0}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="2*" IsReadOnly="True"
                                    Header="{x:Static res:Strings.Fehlzeiten_Col_Hinweis}"
                                    Binding="{Binding ErrorText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
