<Page x:Class="ZeugnisApp.App.Views.FloskelnPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:ZeugnisApp.App.Resources"
      ScrollViewer.CanContentScroll="False"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{x:Static res:Strings.Nav_Floskeln}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{x:Static res:Strings.Floskeln_Title}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static res:Strings.Floskeln_Intro}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                       Content="{x:Static res:Strings.Floskeln_New}" Command="{Binding NeueFloskelCommand}" />
            <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowImport24}"
                       Content="{x:Static res:Strings.Floskeln_Import}" Command="{Binding ImportierenCommand}" />
            <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Eye24}"
                       Content="{x:Static res:Strings.Floskeln_TestPicker}" Command="{Binding AuswahlTestenCommand}" />
        </StackPanel>

        <ui:InfoBar Grid.Row="2" Margin="0,0,0,12"
                    Severity="Success" IsClosable="True"
                    IsOpen="{Binding PickerResult, Converter={StaticResource NullToBool}}"
                    Message="{Binding PickerResult}" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filter panel -->
            <StackPanel Grid.Column="0">
                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.Floskeln_Filter_Bereich}" />
                <ComboBox Margin="0,4,0,12" ItemsSource="{Binding Bereiche}" SelectedItem="{Binding SelectedBereich}" />

                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.Floskeln_Filter_Stufe}" />
                <ComboBox Margin="0,4,0,12" SelectedIndex="{Binding StufeFilter}">
                    <ComboBoxItem Content="{x:Static res:Strings.Floskeln_Filter_All}" />
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="4" />
                </ComboBox>

                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.Floskeln_Filter_Niveau}" />
                <ComboBox Margin="0,4,0,12" SelectedIndex="{Binding NiveauFilter}">
                    <ComboBoxItem Content="{x:Static res:Strings.Floskeln_Filter_All}" />
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="4" />
                    <ComboBoxItem Content="5" />
                </ComboBox>

                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.Floskeln_Filter_Search}" />
                <ui:TextBox Margin="0,4,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- List -->
            <Grid Grid.Column="2">
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static res:Strings.Floskeln_Empty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <DataGrid ItemsSource="{Binding Floskeln}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Header="{x:Static res:Strings.Floskeln_Col_Text}"
                                            Binding="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Width="160" Header="{x:Static res:Strings.Floskeln_Col_Bereich}"
                                            Binding="{Binding Bereich, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                        <DataGridTemplateColumn Width="90" Header="{x:Static res:Strings.Floskeln_Col_Stufe}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding Stufe, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent">
                                        <ComboBoxItem Content="{x:Static res:Strings.Floskeln_Filter_All}" />
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="3" />
                                        <ComboBoxItem Content="4" />
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="90" Header="{x:Static res:Strings.Floskeln_Col_Niveau}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding Niveau, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent">
                                        <ComboBoxItem Content="{x:Static res:Strings.Floskeln_Filter_All}" />
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="3" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="5" />
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="150" Header="{x:Static res:Strings.Floskeln_Col_Gruppe}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding KlassengruppeOptionen}"
                                              DisplayMemberPath="Text"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Klassengruppe, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="{x:Static res:Strings.Common_Delete}" AutomationProperties.Name="{x:Static res:Strings.Common_Delete}" Command="{Binding LoeschenCommand}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Page>
