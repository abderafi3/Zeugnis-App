<ui:FluentWindow x:Class="ZeugnisApp.App.Views.RecoveryKeyWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:ZeugnisApp.App.Resources"
                 Title="{x:Static res:Strings.Recovery_Title}"
                 Icon="pack://application:,,,/ZeugnisApp;component/Resources/app.ico"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Width="560"
                 Height="380"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Recovery_Title}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBox x:Name="KeyBox" Margin="0,16,0,0" FontFamily="Consolas" FontSize="14"
                     TextWrapping="Wrap" AcceptsReturn="False" />

            <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="{DynamicResource ZaErrorBrush}"
                       Visibility="Collapsed" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
            <ui:Button x:Name="CopyButton" Content="{x:Static res:Strings.Recovery_Copy}" Click="OnCopy" Visibility="Collapsed" />
            <ui:Button x:Name="CancelButton" Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Cancel}" Click="OnCancel" />
            <ui:Button x:Name="OkButton" Margin="8,0,0,0" Appearance="Primary" Content="{x:Static res:Strings.Recovery_Continue}" Click="OnOk" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
