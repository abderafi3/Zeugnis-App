<UserControl x:Class="ZeugnisApp.App.Views.Klassen.KlasseEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:ZeugnisApp.App.Resources">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="640" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                           Content="{x:Static res:Strings.Common_Back}"
                           Command="{Binding ZurueckCommand}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
            </StackPanel>

            <TextBlock Margin="0,24,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KlasseEdit_Name}" />
            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{x:Static res:Strings.KlasseEdit_Name_Ph}" />
            <TextBlock Margin="0,4,0,0" Foreground="#D13438" FontSize="12"
                       Text="{Binding NameError}"
                       Visibility="{Binding NameError, Converter={StaticResource NullToCollapsed}}" />

            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KlasseEdit_Jahrgang}" />
            <ui:NumberBox Value="{Binding Jahrgang}" Minimum="1" Maximum="4" SmallChange="1" MaxWidth="120" HorizontalAlignment="Left" />
            <TextBlock Margin="0,4,0,0" Foreground="#D13438" FontSize="12"
                       Text="{Binding JahrgangError}"
                       Visibility="{Binding JahrgangError, Converter={StaticResource NullToCollapsed}}" />

            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KlasseEdit_Klassenleitung}" />
            <ui:TextBox Text="{Binding Klassenleitung, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KlasseEdit_Zeugnisdatum}" />
            <DatePicker SelectedDate="{Binding Zeugnisdatum}" MaxWidth="220" HorizontalAlignment="Left" />

            <TextBlock Margin="0,20,0,6" FontWeight="SemiBold" Text="{x:Static res:Strings.KlasseEdit_Wochenstunden}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock HorizontalAlignment="Center" Text="{x:Static res:Strings.KlasseEdit_Mo}" />
                    <ui:NumberBox Width="70" Value="{Binding Mo}" Minimum="0" Maximum="20" SmallChange="1" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock HorizontalAlignment="Center" Text="{x:Static res:Strings.KlasseEdit_Di}" />
                    <ui:NumberBox Width="70" Value="{Binding Di}" Minimum="0" Maximum="20" SmallChange="1" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock HorizontalAlignment="Center" Text="{x:Static res:Strings.KlasseEdit_Mi}" />
                    <ui:NumberBox Width="70" Value="{Binding Mi}" Minimum="0" Maximum="20" SmallChange="1" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock HorizontalAlignment="Center" Text="{x:Static res:Strings.KlasseEdit_Do}" />
                    <ui:NumberBox Width="70" Value="{Binding Do}" Minimum="0" Maximum="20" SmallChange="1" />
                </StackPanel>
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" Text="{x:Static res:Strings.KlasseEdit_Fr}" />
                    <ui:NumberBox Width="70" Value="{Binding Fr}" Minimum="0" Maximum="20" SmallChange="1" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
