<UserControl x:Class="ZeugnisApp.App.Views.Klassen.KindEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:ZeugnisApp.App.Resources">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" MaxWidth="640" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                           Content="{x:Static res:Strings.Common_Back}"
                           Command="{Binding ZurueckCommand}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
            </StackPanel>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KindEdit_Vorname}" />
                    <ui:TextBox Text="{Binding Vorname, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ZaErrorBrush}" FontSize="12"
                               Text="{Binding VornameError}"
                               Visibility="{Binding VornameError, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KindEdit_Nachname}" />
                    <ui:TextBox Text="{Binding Nachname, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ZaErrorBrush}" FontSize="12"
                               Text="{Binding NachnameError}"
                               Visibility="{Binding NachnameError, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KindEdit_Geburtsdatum}" />
            <DatePicker SelectedDate="{Binding Geburtsdatum}" MaxWidth="220" HorizontalAlignment="Left" />

            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KindEdit_Geschlecht}" />
            <ComboBox MaxWidth="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding GeschlechtOptionen}"
                      DisplayMemberPath="Text"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Geschlecht}" />

            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KindEdit_Schulbesuchsjahr}" />
            <ComboBox MaxWidth="220" HorizontalAlignment="Left" SelectedIndex="{Binding Schulbesuchsjahr}">
                <ComboBoxItem Content="{x:Static res:Strings.KindEdit_Schulbesuchsjahr_Unset}" />
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
            </ComboBox>
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static res:Strings.KindEdit_Schulbesuchsjahr_Hint}" TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KindEdit_Foerderstatus}" />
            <ComboBox MaxWidth="360" HorizontalAlignment="Left"
                      ItemsSource="{Binding FoerderstatusOptionen}"
                      DisplayMemberPath="Text"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Foerderstatus}" />

            <StackPanel Visibility="{Binding ShowFoerderschwerpunkt, Converter={StaticResource BoolToVis}}">
                <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KindEdit_Foerderschwerpunkt}" />
                <ui:TextBox Text="{Binding Foerderschwerpunkt, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{x:Static res:Strings.KindEdit_Foerderschwerpunkt_Ph}" />
            </StackPanel>

            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.KindEdit_ManuellesFormular}" />
            <ComboBox MaxWidth="360" HorizontalAlignment="Left"
                      ItemsSource="{Binding FormularOptionen}"
                      DisplayMemberPath="Anzeigename"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedFormularId}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
