<UserControl x:Class="ZeugnisApp.App.Views.Klassen.KinderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:ZeugnisApp.App.Resources">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                       Content="{x:Static res:Strings.Common_Back}"
                       Command="{Binding ZurueckCommand}" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                       FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <ui:Button Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}"
                       Content="{x:Static res:Strings.Kinder_New}"
                       Command="{Binding NeuesKindCommand}" />
            <ui:Button Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon ArrowImport24}"
                       Content="{x:Static res:Strings.Kinder_Import}"
                       Command="{Binding ImportierenCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static res:Strings.Kinder_Empty}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Kinder}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Binding="{Binding AnzeigeName}"
                                    Header="{x:Static res:Strings.Kinder_Col_Name}" />
                <DataGridTextColumn Width="Auto" Binding="{Binding GeburtsdatumText}"
                                    Header="{x:Static res:Strings.Kinder_Col_Geburtsdatum}" />
                <DataGridTextColumn Width="Auto" Binding="{Binding GeschlechtText}"
                                    Header="{x:Static res:Strings.Kinder_Col_Geschlecht}" />
                <DataGridTextColumn Width="Auto" Binding="{Binding FoerderstatusText}"
                                    Header="{x:Static res:Strings.Kinder_Col_Foerderstatus}" />
                <DataGridTemplateColumn Width="Auto" Header="{x:Static res:Strings.Kinder_Col_Status}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6,1" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#3310893E" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IstVollstaendig}" Value="False">
                                                <Setter Property="Background" Value="#33D13438" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" Text="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#10893E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IstVollstaendig}" Value="False">
                                                    <Setter Property="Foreground" Value="#D13438" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Icon="{ui:SymbolIcon Edit24}" Command="{Binding BearbeitenCommand}" />
                                <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon Delete24}" Command="{Binding LoeschenCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
