<UserControl x:Class="ZeugnisApp.App.Views.Klassen.KlassenListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:ZeugnisApp.App.Resources">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{x:Static res:Strings.Klassen_Title}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static res:Strings.Klassen_Intro}" TextWrapping="Wrap" />
        </StackPanel>

        <ui:Button Grid.Row="1"
                   Margin="0,16,0,16"
                   HorizontalAlignment="Left"
                   Appearance="Primary"
                   Icon="{ui:SymbolIcon Add24}"
                   Content="{x:Static res:Strings.Klassen_New}"
                   Command="{Binding NeueKlasseCommand}" />

        <TextBlock Grid.Row="2"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static res:Strings.Klassen_Empty}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Klassen}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Width="300" Margin="0,0,16,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <Border Margin="10,2,0,0" Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                        <TextBlock FontSize="11" Text="{Binding JahrgangBadge}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Klassenleitung}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding KinderText}" />

                                <Border Margin="0,6,0,0" Padding="6,1"
                                        HorizontalAlignment="Left"
                                        Background="#33D13438"
                                        CornerRadius="4"
                                        Visibility="{Binding HasIncomplete, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource ZaErrorBrush}" Text="{Binding IncompleteText}" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ui:Button Appearance="Secondary"
                                               Icon="{ui:SymbolIcon People24}"
                                               Content="{x:Static res:Strings.Klassen_OpenChildren}"
                                               Command="{Binding OeffnenCommand}" />
                                    <ui:Button Margin="8,0,0,0"
                                               Icon="{ui:SymbolIcon Edit24}"
                                               ToolTip="{x:Static res:Strings.Common_Edit}"
                                               AutomationProperties.Name="{x:Static res:Strings.Common_Edit}"
                                               Command="{Binding BearbeitenCommand}" />
                                    <ui:Button Margin="8,0,0,0"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               ToolTip="{x:Static res:Strings.Common_Delete}"
                                               AutomationProperties.Name="{x:Static res:Strings.Common_Delete}"
                                               Command="{Binding LoeschenCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </Grid>
    </ScrollViewer>
</UserControl>
