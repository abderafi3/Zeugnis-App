<Page x:Class="ZeugnisApp.App.Views.EinstellungenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Einstellungen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Schuleinstellungen" />
            <TextBlock Margin="0,4,0,24"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Diese Angaben erscheinen auf allen Zeugnissen. Änderungen werden automatisch gespeichert." />

            <TextBlock Text="Schulname" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="z. B. Grundschule Wehringhausen" />

            <TextBlock Text="Zusatzbezeichnung" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ui:TextBox Text="{Binding Zusatzbezeichnung, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="z. B. Städt. Gemeinschaftsgrundschule" />

            <TextBlock Text="Adresse" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ui:TextBox Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinLines="2" TextWrapping="Wrap" />

            <TextBlock Text="Schulleitung" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ui:TextBox Text="{Binding Schulleitung, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name der Schulleitung" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Schuljahr" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding Schuljahr, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="z. B. 2026/27" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Aktuelles Halbjahr" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox SelectedIndex="{Binding HalbjahrIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="1. Halbjahr" />
                        <ComboBoxItem Content="2. Halbjahr" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Datum der Zeugnisausgabe" FontWeight="SemiBold" Margin="0,16,0,4" />
            <DatePicker SelectedDate="{Binding Zeugnisausgabedatum}" />

            <TextBlock Text="Konferenzdatum" FontWeight="SemiBold" Margin="0,16,0,4" />
            <DatePicker SelectedDate="{Binding Konferenzdatum}" />

            <TextBlock Text="Wiederbeginn des Unterrichts" FontWeight="SemiBold" Margin="0,16,0,4" />
            <DatePicker SelectedDate="{Binding DatumUnterrichtsWiederbeginn}" />

            <TextBlock Text="Papierkorb: Aufbewahrung (Tage)" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ui:NumberBox Value="{Binding PapierkorbAufbewahrungTage}" Minimum="1" Maximum="3650" SmallChange="1" />

            <ui:Button Margin="0,24,0,0"
                       Appearance="Primary"
                       Content="Jetzt speichern"
                       Command="{Binding SpeichernCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
