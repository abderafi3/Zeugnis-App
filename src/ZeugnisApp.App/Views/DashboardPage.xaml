<Page x:Class="ZeugnisApp.App.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Start">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Schulname}" />
            <TextBlock FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding SchuljahrHalbjahr}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,24,0,12"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="Bereiche" />

        <ItemsControl Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ui:Card Width="260" Height="140" Margin="0,0,16,16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="People24" FontSize="28" />
                    <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="Klassen" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Klassen und Kinder verwalten" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                               Text="{Binding KlassenAnzahl, StringFormat='{}{0} Klassen'}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Width="260" Height="140" Margin="0,0,16,16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="28" />
                    <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="Zeugnisse" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Zeugnisse ausfüllen und erzeugen" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                               Text="{Binding OffeneZeugnisseAnzahl, StringFormat='{}{0} offen'}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Width="260" Height="140" Margin="0,0,16,16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="28" />
                    <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="Formulare" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Zeugnisvorlagen konfigurieren" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                               Text="{Binding FormulareAnzahl, StringFormat='{}{0} Formulare'}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Width="260" Height="140" Margin="0,0,16,16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="28" />
                    <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="Floskeln" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Textbausteine pflegen" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                               Text="{Binding FloskelnAnzahl, StringFormat='{}{0} Floskeln'}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Width="260" Height="140" Margin="0,0,16,16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="CalendarClock24" FontSize="28" />
                    <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="Fehlzeiten" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Fehlstunden erfassen" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                               Text="{Binding KinderAnzahl, StringFormat='{}{0} Kinder'}" />
                </StackPanel>
            </ui:Card>
        </ItemsControl>
    </Grid>
</Page>
