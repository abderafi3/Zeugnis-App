<ui:FluentWindow x:Class="ZeugnisApp.App.Views.Formulare.FeldZuordnungWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:ZeugnisApp.App.Resources"
                 xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
                 Title="{x:Static res:Strings.Zuordnung_Title}"
                 Icon="pack://application:,,,/ZeugnisApp;component/Resources/app.ico"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Width="820"
                 Height="640"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <CollectionViewSource x:Key="ZeilenView" Source="{Binding Zeilen}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Gruppe" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Zuordnung_Title}" ShowMaximize="False" />

        <TextBlock Grid.Row="1" Margin="24,8,24,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static res:Strings.Zuordnung_Intro}" />

        <ItemsControl Grid.Row="2" Margin="24,0"
                      ItemsSource="{Binding Source={StaticResource ZeilenView}}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" FontSize="14" Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Margin="4,0,0,0" Foreground="{DynamicResource ZaErrorBrush}" Text="*"
                                       Visibility="{Binding IstPflicht, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding DataContext.TagOptionen, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  DisplayMemberPath="Anzeige"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding AusgewaehltesTag, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource ZaWarningBrush}"
                           TextWrapping="Wrap" Text="{Binding Hinweis}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding AbbrechenCommand}" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary"
                               Content="{x:Static res:Strings.Zuordnung_Apply}" Command="{Binding UebernehmenCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
