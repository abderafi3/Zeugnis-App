<UserControl x:Class="ZeugnisApp.App.Views.Zeugnisse.ZeugnisEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:ZeugnisApp.App.Resources">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="32,32,32,12">
            <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Content="{x:Static res:Strings.Common_Back}" Command="{Binding ZurueckCommand}" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding FormularLabel}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,0">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <ui:InfoBar Margin="0,0,0,12" Severity="Informational" IsClosable="True"
                            IsOpen="{Binding ZieldifferentHinweisEingefuegt}"
                            Message="{x:Static res:Strings.ZeugnisEditor_ZieldifferentAdded}" />

                <!-- Freitexte -->
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,8" Text="{x:Static res:Strings.ZeugnisEditor_Section_Freitexte}" />
                <ItemsControl ItemsSource="{Binding Freitexte}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           Text="{Binding Hinweis}"
                                           Visibility="{Binding Hinweis, Converter={StaticResource NullToCollapsed}}" />
                                <ui:TextBox Margin="0,4,0,4"
                                            Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                            AcceptsReturn="True" MinLines="3" MaxLines="10" TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                <Grid>
                                    <TextBlock FontSize="12" Text="{Binding ZeichenText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IstUeberlauf}" Value="True">
                                                        <Setter Property="Foreground" Value="#B75B00" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:Button HorizontalAlignment="Right" Icon="{ui:SymbolIcon TextAdd24}"
                                               Content="{x:Static res:Strings.ZeugnisEditor_InsertFloskel}"
                                               Command="{Binding FloskelEinfuegenCommand}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#B75B00"
                                           Text="{x:Static res:Strings.ZeugnisEditor_Overflow}"
                                           Visibility="{Binding IstUeberlauf, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Noten -->
                <StackPanel Visibility="{Binding ShowNoten, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" Text="{x:Static res:Strings.ZeugnisEditor_Section_Noten}" />
                    <ItemsControl ItemsSource="{Binding Noten}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Fach}" />
                                    <ComboBox Grid.Column="1" IsEditable="True"
                                              ItemsSource="{Binding Optionen}"
                                              Text="{Binding Note, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Empfehlung -->
                <StackPanel Visibility="{Binding ShowEmpfehlung, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" Text="{x:Static res:Strings.ZeugnisEditor_Section_Empfehlung}" />
                    <TextBlock Text="{x:Static res:Strings.ZeugnisEditor_Empfehlung}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox IsEditable="True" MaxWidth="320" HorizontalAlignment="Left"
                              ItemsSource="{Binding SchulformOptionen}"
                              Text="{Binding Empfehlung, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="{x:Static res:Strings.ZeugnisEditor_Begruendung}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <ui:TextBox Text="{Binding EmpfehlungBegruendung, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" MinLines="3" MaxLines="8" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Versetzungsvermerk -->
                <StackPanel Visibility="{Binding ShowVersetzung, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" Text="{x:Static res:Strings.ZeugnisEditor_Section_Versetzung}" />
                    <ComboBox IsEditable="True" MaxWidth="420" HorizontalAlignment="Left"
                              ItemsSource="{Binding VersetzungsvermerkOptionen}"
                              Text="{Binding VersetzungsvermerkText, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <!-- Fehlstunden -->
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" Text="{x:Static res:Strings.ZeugnisEditor_Section_Fehlstunden}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:Strings.ZeugnisEditor_Fehlstunden_Gesamt}" Margin="0,0,0,4" />
                        <ui:NumberBox Value="{Binding FehlstundenGesamt}" Minimum="0" SmallChange="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static res:Strings.ZeugnisEditor_Fehlstunden_Unentschuldigt}" Margin="0,0,0,4" />
                        <ui:NumberBox Value="{Binding FehlstundenUnentschuldigt}" Minimum="0" SmallChange="1" />
                    </StackPanel>
                </Grid>

                <!-- Bemerkungen -->
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" Text="{x:Static res:Strings.ZeugnisEditor_Section_Bemerkungen}" />
                <ui:TextBox Margin="0,0,0,24" Text="{Binding Bemerkungen, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True" MinLines="3" MaxLines="10" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="32,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:ToggleSwitch Grid.Column="0" VerticalAlignment="Center"
                                 Content="{x:Static res:Strings.ZeugnisEditor_Fertiggestellt}"
                                 IsChecked="{Binding Fertiggestellt}" />

                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ErzeugenStatus}"
                               Visibility="{Binding ErzeugenStatus, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ZuletztErzeugt}"
                               Visibility="{Binding ZuletztErzeugt, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,8,0"
                                     Visibility="{Binding ErzeugtLaeuft, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon DocumentArrowDown24}"
                               Content="{x:Static res:Strings.ZeugnisEditor_Erzeugen}"
                               Command="{Binding ErzeugenCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
