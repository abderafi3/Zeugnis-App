<ui:FluentWindow x:Class="ZeugnisApp.App.Views.Floskeln.FloskelPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:ZeugnisApp.App.Resources"
                 Title="{x:Static res:Strings.Picker_Title}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Width="760"
                 Height="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Picker_Title}" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Left: filter + list -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding Bereiche}" SelectedItem="{Binding SelectedBereich}" />
                    <ui:TextBox Margin="0,8,0,0"
                                PlaceholderText="{x:Static res:Strings.Floskeln_Filter_Search}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Floskeln}" SelectedItem="{Binding SelectedFloskel}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Bereich}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: sample + preview -->
            <StackPanel Grid.Column="2">
                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.Picker_SampleName}" />
                <ui:TextBox Margin="0,4,0,12" Text="{Binding SampleName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.Picker_SampleGeschlecht}" />
                <ComboBox Margin="0,4,0,12"
                          ItemsSource="{Binding GeschlechtOptionen}"
                          DisplayMemberPath="Text"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SampleGeschlecht}" />

                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.Picker_Preview}" />
                <Border Margin="0,4,0,12" Padding="12" MinHeight="120"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding AbbrechenCommand}" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary"
                               Content="{x:Static res:Strings.Picker_Insert}" Command="{Binding EinfuegenCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
