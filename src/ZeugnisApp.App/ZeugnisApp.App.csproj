<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ZeugnisApp.App</RootNamespace>
    <AssemblyName>ZeugnisApp</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- Sprint 12 packages this self-contained via a dotnet publish profile (RID win-x64,
         SelfContained=true) so a teacher needs no separate .NET install (see plan section 2).
         Kept out of the csproj so day-to-day build and 'dotnet ef' stay framework-dependent and fast. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeugnisApp.Application\ZeugnisApp.Application.csproj" />
    <ProjectReference Include="..\ZeugnisApp.Domain\ZeugnisApp.Domain.csproj" />
    <ProjectReference Include="..\ZeugnisApp.Infrastructure\ZeugnisApp.Infrastructure.csproj" />
    <ProjectReference Include="..\ZeugnisApp.Reporting\ZeugnisApp.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZeugnisApp.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Grundschule Wehringhausen's real, content-control-tagged report forms. Bundled so every
         standard Formular is linked out of the box (see TemplateBootstrapper); "Vorlage hochladen"
         is only needed to replace one. LogicalName pins the resource id against MSBuild mangling. -->
    <EmbeddedResource Include="Resources\Templates\Zeugnis_1_Schulbesuchsjahr.docx">
      <LogicalName>ZeugnisApp.App.Templates.Zeugnis_1_Schulbesuchsjahr.docx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Templates\Zeugnis_2_Schulbesuchsjahr.docx">
      <LogicalName>ZeugnisApp.App.Templates.Zeugnis_2_Schulbesuchsjahr.docx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Templates\Zeugnis_Klasse3_1Halbjahr.docx">
      <LogicalName>ZeugnisApp.App.Templates.Zeugnis_Klasse3_1Halbjahr.docx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Templates\Zeugnis_Klasse3_2Halbjahr.docx">
      <LogicalName>ZeugnisApp.App.Templates.Zeugnis_Klasse3_2Halbjahr.docx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Templates\Zeugnis_Klasse4_1Halbjahr_mit_Begruendung.docx">
      <LogicalName>ZeugnisApp.App.Templates.Zeugnis_Klasse4_1Halbjahr_mit_Begruendung.docx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Templates\Zeugnis_Klasse4_2Halbjahr_mit_Begruendung.docx">
      <LogicalName>ZeugnisApp.App.Templates.Zeugnis_Klasse4_2Halbjahr_mit_Begruendung.docx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Templates\Zeugnis_Gemeinsames_Lernen.docx">
      <LogicalName>ZeugnisApp.App.Templates.Zeugnis_Gemeinsames_Lernen.docx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Templates\Foerderempfehlung.docx">
      <LogicalName>ZeugnisApp.App.Templates.Foerderempfehlung.docx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

</Project>
