<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Spike.SqlCipher</RootNamespace>
    <!-- Throwaway spike (plan §Sprint 0, Spike B): proves the encrypted-provider
         combination the plan mandates for Sprint 11. Not shipped. -->
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CA1050;CA2007;EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Sprint 11 target stack: *.Core packages + SQLCipher native bundle. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
